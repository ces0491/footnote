# Generated match data: rebuilt from seeds with `python -m footnote.generator`.
# Committed: the league and the showcase match with their answer keys (the services deploy the league
# and match files; the answer keys stay out of the images), the showcase's recipe, the name check and
# the agents' recorded evaluation run, which CI replays. Everything else under data/ is rebuilt on
# demand.
/data/*
!/data/showcase_recipe.json
!/data/name_check.json
!/data/league.json
!/data/evals/
!/data/matches/
/data/matches/*
!/data/matches/fl-2627-showcase-sal-kin/
!/data/answer_key/
/data/answer_key/*
!/data/answer_key/league.json
!/data/answer_key/fl-2627-showcase-sal-kin.json

# Node (the web app in frontend/)
node_modules/
.next/

# Environment and secrets
.env
.env.*
!.env.example
.azure/
*.pem
*.key
*.pfx

# Instructions for coding agents, kept on this machine only
CLAUDE.md

# Editors and OS
.vscode/
.idea/
Thumbs.db
.DS_Store
